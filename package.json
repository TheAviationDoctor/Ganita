{
  "name": "ganita",
  "version": "0.1.0",
  "description": "A curated reference site exploring Indian mathematical heritage.",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "test": "node --test scripts/math.test.ts",
    "test:site": "node scripts/audit-build.mjs",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheAviationDoctor/Ganita.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/TheAviationDoctor/Ganita/issues"
  },
  "homepage": "https://github.com/TheAviationDoctor/Ganita#readme",
  "dependencies": {
    "@fontsource-variable/crimson-pro": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/noto-serif-devanagari": "^5.3.0",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  }
