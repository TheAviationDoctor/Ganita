---
import type { CollectionEntry } from 'astro:content';
import { t, label, kindNames, topicNames, type Lang } from '../lib/i18n';
import { articleUrl } from '../lib/articles';
interface Props { article: CollectionEntry<'articles'>; lang: Lang; number?: number; }
const { article, lang, number } = Astro.props;
---
<article class="article-card">
  <div class="card-top"><span class="eyebrow">{label(lang, kindNames[article.data.kind])} <span class="muted">/ {label(lang, topicNames[article.data.topics[0]])}</span></span>{number && <span class="card-number">{String(number).padStart(2, '0')}</span>}</div>
  <h3><a href={articleUrl(lang, article.data.slugKey)}>{article.data.title}</a></h3>
  <p>{article.data.summary}</p>
  <a class="text-link" href={articleUrl(lang, article.data.slugKey)}>{t(lang, 'Read the article', 'लेख पढ़ें')} <span aria-hidden="true">↗</span></a>
</article>
