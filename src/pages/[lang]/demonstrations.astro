---
import Base from '../../layouts/Base.astro';
import { t, languages, type Lang } from '../../lib/i18n';
import { piSeries, partitionExamples } from '../../lib/math';
export const getStaticPaths = () => languages.map(lang => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const initialPi = piSeries(8);
---
<Base title={t(lang, 'The mathematics room', 'गणित कक्ष')} lang={lang}><div class="shell section-block" data-demos data-lang={lang}>
  <header class="page-intro"><p class="eyebrow">{t(lang, 'THREE SMALL EXPERIMENTS', 'तीन छोटे प्रयोग')}</p><h1>{t(lang, 'The mathematics room', 'गणित कक्ष')}</h1><p>{t(lang, 'Historical ideas, modern tools. These interactive explanations use present-day notation and algorithms; they do not reconstruct historical software or prove historical priority.', 'ऐतिहासिक विचार, आधुनिक साधन। इन संवादात्मक व्याख्याओं में वर्तमान संकेतन और एल्गोरिदम हैं; ये ऐतिहासिक सॉफ़्टवेयर का पुनर्निर्माण या ऐतिहासिक प्राथमिकता का प्रमाण नहीं हैं।')}</p></header>
  <noscript><p class="notice">{t(lang, 'JavaScript enables the controls. The initial diagrams, calculations, and linked explanations remain readable without it.', 'नियंत्रणों के लिए जावास्क्रिप्ट आवश्यक है। प्रारंभिक आरेख, गणनाएँ और संबंधित व्याख्याएँ इसके बिना भी पढ़ी जा सकती हैं।')}</p></noscript>
  <nav class="tag-list" aria-label={t(lang, 'Experiments', 'प्रयोग')}><a href="#sine">{t(lang, '01 · Sine and chord', '01 · ज्या और जीवा')}</a><a href="#series">{t(lang, '02 · Approaching π', '02 · π के निकट')}</a><a href="#partitions">{t(lang, '03 · Partitions', '03 · संख्या-विभाजन')}</a></nav>
  <section class="demo" id="sine"><header class="demo-header"><p class="eyebrow">01 / {t(lang, 'GEOMETRY & ASTRONOMY', 'ज्यामिति और खगोलशास्त्र')}</p><h2>{t(lang, 'A sine is a length', 'ज्या एक लंबाई है')}</h2><p>{t(lang, 'For a circle of radius r, the historical sine is a length r sin θ: half a chord subtending 2θ at the centre. Our circle has radius 1. Move θ and compare the vertical projection with the full chord.', 'r त्रिज्या के वृत्त में ऐतिहासिक ज्या एक लंबाई r sin θ है: केंद्र पर 2θ कोण बनाने वाली जीवा का आधा। हमारे वृत्त की त्रिज्या 1 है। θ बदलें और ऊर्ध्वाधर प्रक्षेप की पूरी जीवा से तुलना करें।')}</p></header>
  <div class="demo-layout"><div><label for="angle">{t(lang, 'Angle θ (degrees)', 'कोण θ (अंश)')}</label><input id="angle" type="range" min="0" max="90" step="1" value="30"/><div aria-live="polite" aria-atomic="true"><output for="angle" id="sine-output">θ = 30° · sin θ = 0.500000</output><p id="sine-values">cos θ = 0.866025 · {t(lang, 'Full chord', 'पूरी जीवा')} = 1.000000</p></div><p class="demo-note">{t(lang, 'The modern sine is the ratio (sine length) ÷ radius, so it has no units. At 0° the chord collapses; at 90° it is a diameter. The diagram uses the same scale on both axes.', 'आधुनिक साइन अनुपात (ज्या की लंबाई) ÷ त्रिज्या है, इसलिए उसकी कोई इकाई नहीं है। 0° पर जीवा सिमट जाती है; 90° पर वह व्यास है। आरेख में दोनों अक्षों का पैमाना समान है।')}</p><a class="text-link" href={`/${lang}/articles/aryabhata/`}>{t(lang, 'Read about Āryabhaṭa', 'आर्यभट के बारे में पढ़ें')} →</a></div>
  <figure class="demo-figure"><svg id="sine-svg" viewBox="0 0 360 330" role="img" aria-labelledby="sine-title sine-description"><title id="sine-title">{t(lang, 'Sine and chord on a unit circle', 'इकाई वृत्त पर ज्या और जीवा')}</title><desc id="sine-description">{t(lang, 'At 30 degrees, the sine length is 0.5 and the full chord is 1.', '30 अंश पर ज्या की लंबाई 0.5 और पूरी जीवा 1 है।')}</desc><circle cx="165" cy="165" r="125" fill="none" stroke="#8b8c76"/><path d="M25 165H305M165 25V305" stroke="#c2bca7"/><line id="radius-line" x1="165" y1="165" x2="273.253" y2="102.5" stroke="#28372e" stroke-width="2"/><line id="reflect-line" x1="165" y1="165" x2="273.253" y2="227.5" stroke="#8b8c76" stroke-dasharray="4 4"/><line id="chord-line" x1="273.253" y1="102.5" x2="273.253" y2="227.5" stroke="#9c432c" stroke-width="2"/><line id="sine-line" x1="273.253" y1="165" x2="273.253" y2="102.5" stroke="#9c432c" stroke-width="4"/><line id="cos-line" x1="165" y1="165" x2="273.253" y2="165" stroke="#28372e" stroke-width="2"/><circle id="sine-point" cx="273.253" cy="102.5" r="4" fill="#9c432c"/><text x="147" y="184" fill="#41483e" font-size="14">O</text><text x="176" y="43" fill="#686b60" font-size="12">r = 1</text></svg><figcaption>{t(lang, 'Bold vertical segment: sine length. Thin vertical line: full chord.', 'मोटा ऊर्ध्वाधर खंड: ज्या की लंबाई। पतली ऊर्ध्वाधर रेखा: पूरी जीवा।')}</figcaption></figure></div></section>
  <section class="demo" id="series"><header class="demo-header"><p class="eyebrow">02 / {t(lang, 'INFINITE SERIES', 'अनंत श्रेणियाँ')}</p><h2>{t(lang, 'How close is close enough?', 'कितना निकट पर्याप्त है?')}</h2><p>{t(lang, 'Compare two series associated with the Kerala tradition. Each alternating sum approaches π, but their speed differs dramatically. We show raw partial sums, without the historical end corrections.', 'केरल परंपरा से जुड़ी दो श्रेणियों की तुलना करें। दोनों एकांतर योग π के निकट जाते हैं, पर उनकी गति बहुत अलग है। यहाँ ऐतिहासिक अंतिम सुधारों के बिना सीधे आंशिक योग दिखाए गए हैं।')}</p></header>
  <div class="demo-layout"><div><label for="series-type">{t(lang, 'Choose a series', 'श्रेणी चुनें')}</label><select id="series-type"><option value="slow">{t(lang, '4 × (1 − 1/3 + 1/5 − …)', '4 × (1 − 1/3 + 1/5 − …)')}</option><option value="fast">{t(lang, '√12 × (1 − 1/9 + 1/45 − …)', '√12 × (1 − 1/9 + 1/45 − …)')}</option></select><p class="demo-formula" id="series-formula">4 × Σ (−1)ᵏ / (2k + 1), k = 0, …, n − 1</p><label for="terms">{t(lang, 'Number of terms n', 'पदों की संख्या n')}</label><input id="terms" type="range" min="1" max="100" step="1" value="8"/><div aria-live="polite" aria-atomic="true"><p id="terms-label">n = 8</p><output for="terms series-type" id="pi-output">{initialPi.value.toFixed(12)}</output><p id="pi-bound">{t(lang, 'Truncation error ≤', 'पद-छँटाई त्रुटि ≤')} {initialPi.bound.toPrecision(4)}</p><p id="pi-error">{t(lang, 'Difference from Math.PI:', 'Math.PI से अंतर:')} {Math.abs(initialPi.value - Math.PI).toPrecision(4)}</p></div><p class="demo-note">{t(lang, 'The next omitted term bounds the mathematical truncation error. Beyond about 14 decimal digits, floating-point rounding dominates; more terms cannot guarantee more displayed digits. Math.PI is a floating-point reference, not an exact value.', 'अगला छोड़ा गया पद गणितीय पद-छँटाई त्रुटि की सीमा देता है। लगभग 14 दशमलव अंकों के बाद कंप्यूटर की पूर्णांकन त्रुटि प्रमुख होती है; अधिक पद अधिक प्रदर्शित अंकों की गारंटी नहीं देते। Math.PI एक कंप्यूटरी संदर्भ है, सटीक मान नहीं।')}</p><a class="text-link" href={`/${lang}/articles/madhava/`}>{t(lang, 'Read about Mādhava', 'माधव के बारे में पढ़ें')} →</a></div><div><p class="eyebrow">{t(lang, 'FIRST PARTIAL SUMS', 'प्रारंभिक आंशिक योग')}</p><table class="mini-table"><caption class="demo-note">{t(lang, 'First eight sums, or all sums if fewer than eight terms are chosen.', 'प्रथम आठ योग, या आठ से कम पद चुने जाने पर सभी योग।')}</caption><thead><tr><th scope="col">n</th><th scope="col">{t(lang, 'Approximation to π', 'π का सन्निकटन')}</th></tr></thead><tbody id="series-table">{initialPi.partials.map((value, i) => <tr><td>{i + 1}</td><td>{value.toFixed(9)}</td></tr>)}</tbody></table><p class="demo-note">π ≈ 3.141592653589793</p><p class="demo-note">{t(lang, 'Slow series bound: 4/(2n + 1). Faster series bound: √12 / ((2n + 1) × 3ⁿ). Both follow from decreasing alternating terms.', 'धीमी श्रेणी की सीमा: 4/(2n + 1)। तेज़ श्रेणी की सीमा: √12 / ((2n + 1) × 3ⁿ)। दोनों घटते एकांतर पदों से मिलती हैं।')}</p></div></div></section>
  <section class="demo" id="partitions"><header class="demo-header"><p class="eyebrow">03 / {t(lang, 'NUMBER & PATTERN', 'संख्या और प्रतिरूप')}</p><h2>{t(lang, 'How many ways to make a number?', 'एक संख्या कितने तरीक़ों से बनती है?')}</h2><p>{t(lang, 'A partition writes a positive integer as a sum of positive integers, ignoring order. Thus 3 + 1 and 1 + 3 are the same partition. This modern counting algorithm makes Ramanujan’s congruence p(5k + 4) ≡ 0 (mod 5) visible in small examples.', 'संख्या-विभाजन में धन पूर्णांक को धन पूर्णांकों के योग के रूप में लिखा जाता है और क्रम नहीं गिना जाता। इसलिए 3 + 1 और 1 + 3 एक ही विभाजन हैं। यह आधुनिक गणना-विधि छोटे उदाहरणों में रामानुजन की सर्वांगसमता p(5k + 4) ≡ 0 (mod 5) दिखाती है।')}</p></header>
  <div class="demo-layout"><div><label for="partition-n">{t(lang, 'Integer n', 'पूर्णांक n')}</label><input id="partition-n" type="range" min="1" max="20" step="1" value="4"/><div aria-live="polite" aria-atomic="true"><output for="partition-n" id="partition-output">p(4) = 5</output><p id="partition-congruence">{t(lang, '4 = 5 × 0 + 4; p(4) = 5 is divisible by 5.', '4 = 5 × 0 + 4; p(4) = 5, 5 से विभाज्य है।')}</p></div><p class="demo-note">{t(lang, 'Exact integer arithmetic counts every partition. The list shows the first 32 at most, in decreasing lexicographic order. Finite examples illustrate the congruence; they do not prove it for all integers.', 'सटीक पूर्णांक गणना हर विभाजन को गिनती है। सूची घटते शब्दकोशीय क्रम में अधिकतम प्रथम 32 विभाजन दिखाती है। सीमित उदाहरण सर्वांगसमता का चित्रण हैं; वे सभी पूर्णांकों के लिए प्रमाण नहीं हैं।')}</p><p class="demo-result">p(4) = 5 · p(9) = 30<br/>p(14) = 135 · p(19) = 490</p><a class="text-link" href={`/${lang}/articles/ramanujan/`}>{t(lang, 'Read about Ramanujan', 'रामानुजन के बारे में पढ़ें')} →</a></div><div><p class="eyebrow" id="partition-list-label">{t(lang, 'ALL 5 PARTITIONS', 'सभी 5 विभाजन')}</p><ul class="partition-list" id="partition-list">{partitionExamples(4).map(parts => <li>{parts.join(' + ')}</li>)}</ul></div></div></section>
  <p class="figure-attribution">{t(lang, 'All diagrams and code are original to this project. Historical sources appear in the linked articles and bibliography.', 'सभी आरेख और कोड इस परियोजना के मौलिक कार्य हैं। ऐतिहासिक स्रोत संबंधित लेखों और ग्रंथसूची में हैं।')} <a href={`/${lang}/credits/`}>{t(lang, 'Attribution', 'श्रेय')}</a></p>
</div></Base>
<script>
  import { sineMeasure, piSeries, partitionCounts, partitionExamples } from '../../lib/math';
  const root = document.querySelector<HTMLElement>('[data-demos]');
  if (root) {
    const hi = root.dataset.lang === 'hi';
    const el = <T extends HTMLElement>(id: string) => root.querySelector<T>(`#${id}`)!;
    const angle = el<HTMLInputElement>('angle');
    function updateSine() {
      const degrees = Number(angle.value);
      const values = sineMeasure(degrees);
      const x = 165 + 125 * values.cosine;
      const y = 165 - 125 * values.sine;
      const below = 165 + 125 * values.sine;
      function attrs(id: string, values: Record<string, number>) { for (const [name, value] of Object.entries(values)) el(id).setAttribute(name, String(value)); }
      attrs('radius-line', { x2: x, y2: y });
      attrs('reflect-line', { x2: x, y2: below });
      attrs('chord-line', { x1: x, x2: x, y1: y, y2: below });
      attrs('sine-line', { x1: x, x2: x, y2: y });
      attrs('cos-line', { x2: x });
      attrs('sine-point', { cx: x, cy: y });
      el('sine-output').textContent = `θ = ${degrees}° · sin θ = ${values.sine.toFixed(6)}`;
      el('sine-values').textContent = `cos θ = ${values.cosine.toFixed(6)} · ${hi ? 'पूरी जीवा' : 'Full chord'} = ${values.chord.toFixed(6)}`;
      el('sine-description').textContent = hi ? `${degrees} अंश पर ज्या ${values.sine.toFixed(6)} और पूरी जीवा ${values.chord.toFixed(6)} है।` : `At ${degrees} degrees, the sine length is ${values.sine.toFixed(6)} and full chord is ${values.chord.toFixed(6)}.`;
    }
    angle.addEventListener('input', updateSine);
    const terms = el<HTMLInputElement>('terms');
    const series = el<HTMLSelectElement>('series-type');
    function updateSeries() {
      const n = Number(terms.value);
      const fast = series.value === 'fast';
      const result = piSeries(n, fast);
      el('terms-label').textContent = `n = ${n}`;
      el('pi-output').textContent = result.value.toFixed(12);
      el('pi-bound').textContent = `${hi ? 'पद-छँटाई त्रुटि ≤' : 'Truncation error ≤'} ${result.bound.toPrecision(4)}`;
      el('pi-error').textContent = `${hi ? 'Math.PI से अंतर:' : 'Difference from Math.PI:'} ${Math.abs(result.value - Math.PI).toPrecision(4)}`;
      el('series-formula').textContent = fast ? '√12 × Σ (−1)ᵏ / ((2k + 1) × 3ᵏ), k = 0, …, n − 1' : '4 × Σ (−1)ᵏ / (2k + 1), k = 0, …, n − 1';
      const rows = result.partials.slice(0, 8).map((value, i) => {
        const tr = document.createElement('tr');
        for (const text of [String(i + 1), value.toFixed(9)]) { const td = document.createElement('td'); td.textContent = text; tr.append(td); }
        return tr;
      });
      el('series-table').replaceChildren(...rows);
    }
    terms.addEventListener('input', updateSeries);
    series.addEventListener('change', updateSeries);
    const partitionN = el<HTMLInputElement>('partition-n');
    function updatePartitions() {
      const n = Number(partitionN.value);
      const count = partitionCounts(n)[n];
      el('partition-output').textContent = `p(${n}) = ${count}`;
      el('partition-congruence').textContent = n % 5 === 4
        ? hi ? `${n} = 5 × ${(n - 4) / 5} + 4; p(${n}) = ${count}, 5 से विभाज्य है।` : `${n} = 5 × ${(n - 4) / 5} + 4; p(${n}) = ${count} is divisible by 5.`
        : hi ? `${n}, 5k + 4 के रूप में नहीं है; इस नियम से इसके बारे में कोई निष्कर्ष नहीं मिलता।` : `${n} is not of the form 5k + 4; this congruence makes no claim about it.`;
      const examples = partitionExamples(n);
      const items = examples.map(parts => { const li = document.createElement('li'); li.textContent = parts.join(' + '); return li; });
      el('partition-list').replaceChildren(...items);
      el('partition-list-label').textContent = BigInt(examples.length) === count ? hi ? `सभी ${count} विभाजन` : `ALL ${count} PARTITIONS` : hi ? `${count} में से प्रथम ${examples.length} विभाजन` : `FIRST ${examples.length} OF ${count} PARTITIONS`;
    }
    partitionN.addEventListener('input', updatePartitions);
  }
</script>
