---
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import ArticleCard from '../../../../components/ArticleCard.astro';
import { displayTag, type Lang, t } from '../../../../lib/i18n';
import { browseUrl } from '../../../../lib/articles';
export async function getStaticPaths() {
  const all = await getCollection('articles');
  const paths = new Map();
  for (const article of all) {
    const { lang, people, period, topics, texts } = article.data;
    for (const [type, values] of [['person', people], ['period', [period]], ['topic', topics], ['text', texts]] as [string, string[]][]) {
      for (const value of values) paths.set(`${lang}/${type}/${value}`, { params: { lang, type, value } });
    }
  }
  return [...paths.values()];
}
const { type, value } = Astro.params as { type: string; value: string };
const lang = Astro.params.lang as Lang;
const field = ({ person: 'people', period: 'period', topic: 'topics', text: 'texts' } as const)[type as 'person' | 'period' | 'topic' | 'text'];
const articles = (await getCollection('articles')).filter(a => a.data.lang === lang && (Array.isArray(a.data[field]) ? (a.data[field] as string[]).includes(value) : a.data[field] === value));
const title = displayTag(lang, type, value);
const alternate = browseUrl(lang === 'en' ? 'hi' : 'en', type, value);
---
<Base title={title} lang={lang} alternate={alternate}><div class="shell section-block"><a class="text-link" href={`/${lang}/explore/`}>← {t(lang, 'The collection', 'लेख-संग्रह')}</a><header class="page-intro"><p class="eyebrow">{t(lang, 'CONNECTED READINGS', 'संबंधित लेख')}</p><h1>{title}</h1><p>{articles.length} {t(lang, 'articles in this part of the collection.', 'लेख संग्रह के इस भाग में।')}</p></header><div class="card-grid">{articles.map(article => <ArticleCard article={article} lang={lang}/>)}</div></div></Base>
